{
    "name": "sipena-ai/sipena-ai",
    "description": "SIPENA AI - Sistem Informasi Presensi dan Administrasi Guru Berbasis AI untuk SMK Negeri 5 Tanjungpinang",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0",
        "laravel/breeze": "^2.0",
        "laravel/queue": "^12.0",
        "laravel/scheduler": "^12.0",
        "spatie/laravel-permission": "^6.4",
        "guzzlehttp/guzzle": "^7.8",
        "barryvdh/laravel-dompdf": "^2.1",
        "maatwebsite/excel": "^3.1",
        "intervention/image": "^3.7",
        "laravel/tinker": "^2.9",
        "predis/predis": "^2.2",
        "laravel-notification-channels/telegram": "^0.3",
        "qdrant/qdrant-client": "^1.0",
        "symfony/http-client": "^7.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/pint": "^1.16",
        "laravel/sail": "^1.29",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.4",
        "phpunit/phpunit": "^11.5",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\": "database/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\\\Foundation\\\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-install-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
